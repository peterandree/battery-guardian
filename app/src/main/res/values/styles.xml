<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.BatteryGuardian">
        <!-- Customize your theme here. -->
    </style>
    
    <!-- Text styles -->
    <style name="TextAppearance.Body1" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/text_primary</item>
    </style>
    
    <style name="TextAppearance.Body2" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/text_secondary</item>
    </style>
    
    <style name="TextAppearance.Caption" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textColor">@color/text_tertiary</item>
    </style>
    
    <!-- Card styles -->
    <style name="CardStyle" parent="Widget.Material3.Card">
        <item name="android:background">@color/surface_container</item>
        <item name="cardElevation">4dp</item>
        <item name="cardCornerRadius">12dp</item>
    </style>
    
    <!-- Battery level indicator styles -->
    <style name="BatteryLevel.High">
        <item name="android:textColor">@color/battery_high</item>
    </style>
    
    <style name="BatteryLevel.Medium">
        <item name="android:textColor">@color/battery_medium</item>
    </style>
    
    <style name="BatteryLevel.Low">
        <item name="android:textColor">@color/battery_low</item>
    </style>
    
    <style name="BatteryLevel.Critical">
        <item name="android:textColor">@color/battery_critical</item>
    </style>
</resources>
